# Hashes for the kernel source tarballs used by the EmonOS defconfigs.
# Buildroot picks this file up through BR2_GLOBAL_PATCH_DIR and verifies the
# downloaded tarball against it, so a changed or tampered tarball fails the build.
#
# x86-64-vm: https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc
sha256  e82fe40871743048226987bd349ef107168b15aab90140e872ca4ed470922e25  linux-6.12.47.tar.xz

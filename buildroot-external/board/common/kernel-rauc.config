CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
# Reboot after kernel panics so an uncommitted trial can fall back even when
# the panic occurs before systemd has opened and armed the hardware watchdog.
CONFIG_PANIC_TIMEOUT=10

image efi-part.vfat {
    vfat {
        file EFI {
            image = "efi-part/EFI"
        }

    }

    size = 16352K
}

image emonos-x86-64-vm.img {
    hdimage {
        partition-table-type = "gpt"
    }

    partition boot {
        image = "efi-part.vfat"
        partition-type-uuid = U
        offset = 32K
        bootable = true
    }

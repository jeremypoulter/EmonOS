#!/bin/sh
set -eu

preload=/mnt/data/preload
archive="$preload/images.tar"
checksum="$preload/images.tar.sha256"
done=/mnt/data/.preload.done

mkdir -p "$(dirname "$done")"

# A prior run may have committed the completion marker and lost power before
# deleting its recovery archive. The marker is written only after docker load
# and sync, so the images are durable; clean up the stale archive and succeed.
if test -e "$done"; then
    rm -f "$archive" "$checksum" "$done.tmp"
    sync
    exit 0
fi

test -f "$archive"
test -f "$checksum"
expected=$(cat "$checksum")

# Verify and load in one pass. Hashing the archive first costs a full extra
# read and CPU pass before docker can start; on a multi-core device the two now
# overlap. The checksum detects corruption of the archive on the data
# partition; it does not authenticate it. The unit fails, and keeps the
# archive, on a mismatch, so emonos-app (which requires this unit) never starts
# from unverified images.
#
# KNOWN, ACCEPTED RISK (R13 in Docs/emonos-poc-implementation-plan.md): the
# images are streamed into Docker before the checksum is known, so on a
# mismatch a still-valid archive's images and tags remain in Docker's store.
# Nothing starts them, but they are not removed. Accepted by the maintainer;
# revisit if branch protection / merge queues do not gate main as planned.
work=$(mktemp -d /run/emonos-preload.XXXXXX)
trap 'rm -rf "$work"' EXIT
mkfifo "$work/archive"
# Open the archive before starting the hasher. If it cannot be opened, fail now:
# the hasher would otherwise block forever waiting for a writer on the FIFO.
exec 3< "$archive"
sha256sum < "$work/archive" | awk '{print $1}' > "$work/actual" &
hasher=$!

load_status=0
tee "$work/archive" <&3 | docker load || load_status=$?
exec 3<&-
hash_status=0
wait "$hasher" || hash_status=$?

test "$load_status" -eq 0
test "$hash_status" -eq 0
actual=$(cat "$work/actual")
if test "$actual" != "$expected"; then
    echo "emonos-preload: archive checksum mismatch (expected $expected, got $actual)" >&2
    exit 1
fi

# Persist Docker's successful import before publishing the completion marker.
# Write the marker in the same directory and rename it atomically: after any
# interruption, either the archive is available for a safe retry or the marker
# proves the imported images were committed. Never delete recovery input first.
sync
printf '%s\n' "$actual" > "$done.tmp"
sync
mv "$done.tmp" "$done"
sync
rm -f "$archive" "$checksum"
sync

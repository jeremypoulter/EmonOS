[system]
compatible=@COMPATIBLE@
bootloader=@BOOTLOADER@
@BOOTLOADER_OPTIONS@
bundle-formats=verity
data-directory=/mnt/data/rauc
mountprefix=/run/rauc

[keyring]
path=/etc/rauc/keyring.pem
# PoC devices have no battery-backed clock. Development only: validate the
# certificate at the authenticated signing time, not the reset device clock.
use-bundle-signing-time=true

[handlers]
system-info=/usr/libexec/emonos-rauc-info

[slot.boot.0]
device=/dev/disk/by-partlabel/boot
type=vfat
readonly=true

[slot.kernel.0]
device=/dev/disk/by-partlabel/kernel-a
type=raw
bootname=A

[slot.rootfs.0]
device=/dev/disk/by-partlabel/system-a
type=raw
parent=kernel.0

[slot.kernel.1]
device=/dev/disk/by-partlabel/kernel-b
type=raw
bootname=B

[slot.rootfs.1]
device=/dev/disk/by-partlabel/system-b
type=raw
parent=kernel.1

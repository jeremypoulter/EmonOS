[Unit]
Description=Load EmonOS preloaded container images
Requires=mnt-data.mount docker.service
After=mnt-data.mount docker.service
Before=emonos-app.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/emonos-preload
RemainAfterExit=yes
# On a factory first boot emonos-health waits up to 3600 s for this unit's
# completion marker. Bound the load to match, so a hung load ends too.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target

[Unit]
Description=Load EmonOS preloaded container images
Requires=mnt-data.mount docker.service
After=mnt-data.mount docker.service
Before=emonos-app.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/emonos-preload
RemainAfterExit=yes
# emonos-health waits for this unit. Bound it so a hung load still ends and
# lets the health monitor fail the slot, rather than holding it off forever.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
